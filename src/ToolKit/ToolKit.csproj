<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<RootNamespace>FatCat.Toolkit</RootNamespace>
		<AssemblyName>FatCat.Toolkit</AssemblyName>
		<DebugType>full</DebugType>
		<LangVersion>default</LangVersion>
		<VersionPrefix>1.0.357</VersionPrefix>
		<Authors>David Basarab</Authors>
		<PackageTags>tools</PackageTags>
		<PackageProjectUrl>https://github.com/DavidBasarab/FatCat.Toolkit</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/DavidBasarab/FatCat.Toolkit</RepositoryUrl>
		<NoWarn>CS8002,CS1700</NoWarn>
		<SignAssembly>true</SignAssembly>
		<TargetFramework>net11.0</TargetFramework>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
	<PropertyGroup>
		<NoWarn>$(NoWarn);NETSDK1206;NU1902;NU1903</NoWarn>
		<NuGetAuditMode>direct</NuGetAuditMode>
	</PropertyGroup>
	<ItemGroup>
		<RuntimeHostConfigurationOption Include="System.Runtime.Loader.UseRidGraph" Value="true" />
	</ItemGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<NoWarn>CS8002,CS1700;IL2121;CS8618;IL2121;CS8603;NU1903</NoWarn>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<NoWarn>CS8002,CS1700;IL2121;CS8618;IL2121;CS8603;NU1903</NoWarn>
	</PropertyGroup>
	<PropertyGroup>
		<DisableImplicitSystemNetHttpPackage>true</DisableImplicitSystemNetHttpPackage>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo
			Include="Tests.FatCat.Toolkit"
			Key=""
		/>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Autofac" Version="9.3.4" />
		<PackageReference Include="CSharpier.MsBuild" Version="1.4.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="DebounceThrottle" Version="3.0.1" />
		<PackageReference Include="FakeItEasy" Version="9.0.1" />
		<PackageReference Include="fasterflect" Version="3.0.0" />
		<PackageReference Include="FatCat.Fakes" Version="1.0.33" />
		<PackageReference Include="FatCat.Testing" Version="1.0.8" />
		<PackageReference Include="Humanizer.Core" Version="3.0.10" />
		<PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
		<PackageReference Include="MongoDB.Driver" Version="3.14.0" />
		<PackageReference Include="MongoDB.Driver.Core.Extensions.DiagnosticSources" Version="3.0.0" />
		<PackageReference Include="System.IO.Abstractions" Version="23.0.0" />
		<PackageReference Include="xunit.extensibility.core" Version="2.9.3" />
	</ItemGroup>
</Project>
